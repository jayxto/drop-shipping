PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
# Optional. Without both values generation uses the clearly labelled demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=
# browser (default): runs Chromium to render JavaScript. metadata: old static mode.
ALIEXPRESS_IMPORT_MODE=browser
# chromium (installed by Playwright), or msedge/chrome when already installed.
BROWSER_CHANNEL=chromium
# Optional extractor for AliExpress pages that require browser rendering.
# HTTPS endpoint accepts POST {url} and returns bridge product JSON (see README).
SCRAPER_API_URL=
SCRAPER_API_KEY=
# demo or connected. Connected mode supports OAuth and payload preparation;
# live publication intentionally returns 501 until marketplace adapters are completed.
MARKETPLACE_MODE=demo
# For any non-loopback deployment set a strong password, serve behind HTTPS.
APP_PASSWORD=
ETSY_CLIENT_ID=
ETSY_SHARED_SECRET=
# Etsy requires a registered HTTPS callback, see README.
ETSY_REDIRECT_URI=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay redirect_uri is the RuName registered in the developer portal, NOT a URL.
EBAY_REDIRECT_URI=
EBAY_SANDBOX=true
